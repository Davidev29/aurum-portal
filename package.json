{
  "name": "aurumbit-portal",
  "version": "0.1.0",
  "private": true,
  "description": "AurumBit Portal - cofre de acessos e sessoes isoladas para portais publicos brasileiros",
  "author": {
    "name": "AurumBit Portal",
    "email": "suporte@aurumbit.local"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n renderer,main,electron -c cyan,magenta,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "next dev --port 3000",
    "dev:main": "tsup --watch",
    "dev:electron": "wait-on http://localhost:3000 dist-electron/main.cjs && cross-env AURUMBIT_DEV_URL=http://localhost:3000 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "next build",
    "build:main": "tsup",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "spike": "tsx scripts/spike/run-spike.ts",
    "spike:certs": "tsx scripts/spike/generate-certs.ts",
    "simulate:cert": "tsx scripts/spike/simulate-cert-selection.ts",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "@tanstack/react-query": "5.105.1",
    "@types/qrcode": "^1.5.6",
    "asn1js": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.4",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "graphify": "^1.0.0",
    "hash-wasm": "4.12.0",
    "lucide-react": "0.468.0",
    "next": "16.4.4",
    "next-themes": "0.4.6",
    "node-forge": "1.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pkijs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.22",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "27.2.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "wait-on": "9.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
