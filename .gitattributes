# Normaliza line endings: LF no repositório e no checkout (Windows incluído),
# evitando falhas do Prettier (endOfLine: "lf") por checkout com CRLF.
* text=auto eol=lf

# Hooks de git precisam de LF (shebang) em qualquer clone
.githooks/** text eol=lf

# Binários explícitos
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.pfx binary
*.p12 binary
*.icns binary
*.node binary
*.dll binary
*.exe binary
*.woff binary
*.woff2 binary
