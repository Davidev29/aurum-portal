# EditorConfig — AurumBit Portal
# O repositório é 100% LF no índice do git (ver .gitattributes). Este arquivo
# garante que os editores mantenham LF e UTF-8 no working tree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
